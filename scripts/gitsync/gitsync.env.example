# /etc/gitsync.env for gitsync.service (mode 0600). URLs carry no credentials.
GITSYNC_GITLAB_URL=http://gitlab.example.com/group/gpuworks.git
# A project access token with the Maintainer role and write_repository scope.
GITSYNC_GITLAB_TOKEN=
GITSYNC_GITHUB_URL=https://github.com/owner/gpuworks.git
# A GitHub App installed on the repository with Contents and Workflows: read
# and write (GitHub refuses a push that changes .github/workflows/ without
# the latter), allowed to bypass the protected-branch rules.
GITSYNC_GITHUB_APP_ID=
GITSYNC_GITHUB_APP_KEY_FILE=/etc/gitsync-github-app.pem
# Optional: a DingTalk robot for alerts.
GITSYNC_DINGTALK_WEBHOOK=
