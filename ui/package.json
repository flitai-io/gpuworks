{
  "name": "gpuworks-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint:i18n": "eslint",
    "preview": "vite preview",
    "test": "tsx --import ./tests/helpers/rtlTimeout.ts --import ./tests/helpers/reactDomOrder.ts --test tests/*.test.ts tests/*.test.tsx",
    "test:coverage": "c8 --all --include='src/**/*.{ts,tsx}' --exclude='src/**/*.d.ts' --reporter=text --reporter=lcov tsx --import ./tests/helpers/rtlTimeout.ts --import ./tests/helpers/reactDomOrder.ts --test ${TEST_SHARD:+--test-shard=$TEST_SHARD} tests/*.test.ts tests/*.test.tsx"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "antd": "^5.21.0",
    "codemirror-json-schema": "^0.8.1",
    "dayjs": "^1.11.11",
    "echarts": "^5.6.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jotai": "^2.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.12",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
