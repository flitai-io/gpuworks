    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/hast": "^3.0.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^4.3.2",
    "c8": "^12.0.0",
    "eslint": "^10.9.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
