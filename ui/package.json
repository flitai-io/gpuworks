{
  "name": "gpuworks-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node ensure-deps.mjs && vite build --config vite.report.config.ts",
    "dev": "vite",
    "prebuild": "node ensure-deps.mjs",
    "build": "vite build --config vite.report.config.ts && tsc -b && vite build",
    "lint:i18n": "eslint",
    "preview": "vite preview",
    "pretest": "node ensure-deps.mjs",
    "test": "tsx --import ./tests/helpers/rtlTimeout.ts --import ./tests/helpers/reactDomOrder.ts --test --test-force-exit --test-timeout=300000 ${UI_TEST_CONCURRENCY:+--test-concurrency=$UI_TEST_CONCURRENCY} tests/*.test.ts tests/*.test.tsx",
    "test:coverage": "c8 --all --include='src/**/*.{ts,tsx}' --exclude='src/**/*.d.ts' --reporter=text --reporter=lcov tsx --import ./tests/helpers/rtlTimeout.ts --import ./tests/helpers/reactDomOrder.ts --test --test-force-exit --test-timeout=300000 ${UI_TEST_CONCURRENCY:+--test-concurrency=$UI_TEST_CONCURRENCY} ${TEST_SHARD:+--test-shard=$TEST_SHARD} tests/*.test.ts tests/*.test.tsx"
  },
  "dependencies": {
    "@ant-design/cssinjs": "1.24.0",
    "@ant-design/icons": "^5.5.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@base-ui/react": "^1.9.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^7.0.3",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "antd": "^5.22.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror-json-schema": "^0.8.1",
    "dayjs": "^1.11.11",
    "deepmerge": "file:vendor/deepmerge",
    "echarts": "^6.1.0",
    "framer-motion": "^12.43.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "jotai": "^2.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.0.12",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/hast": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^4.3.2",
    "c8": "^12.0.0",
    "eslint": "^10.9.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.65.0",
    "tailwindcss": "4.1.18",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2",
    "vite": "^6.4.5"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3",
    "deepmerge": "$deepmerge"
  }
}
