        "zh": "投机步数"
      },
      "type": "integer",
      "control": "number",
      "group": "speculative",
      "min": 1,
      "step": 1,
      "engines": [
        "sglang"
      ]
    },
    {
      "key": "speculative_eagle_top_k",
