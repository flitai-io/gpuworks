    {
      "key": "enable_auto_tool_choice",
      "flag": "--enable-auto-tool-choice",
      "label": {
        "en": "Automatic Tool Selection",
        "zh": "自动选择工具"
      },
      "type": "boolean",
      "control": "switch",
      "group": "model",
      "default": false,
      "help": {
        "en": "Allow the model to select tools automatically for each request",
        "zh": "允许模型根据请求自动选择工具"
      },
      "engines": [
        "sglang"
      ]
    },
    {
      "key": "gpu_memory_utilization",
      "flag": "--mem-fraction-static",
      "label": {
        "en": "GPU Memory Utilization",
        "zh": "显存使用率"
      },
      "type": "number",
      "control": "slider",
      "group": "performance",
      "default": 0.88,
      "min": 0.01,
      "max": 0.98,
      "step": 0.01,
      "help": {
        "en": "Per-GPU memory limit for this instance; divide capacity manually when multiple instances share a GPU",
        "zh": "本实例的每卡显存上限；同卡多实例时需自行分摊"
      },
      "engines": [
        "sglang"
      ],
      "layout": "quick",
      "order": 11
    },
    {
      "key": "max_num_batched_tokens",
      "flag": "--chunked-prefill-size",
      "label": {
        "en": "Maximum Batched Tokens",
        "zh": "单批最大 Token 数"
      },
      "type": "integer",
      "control": "number",
      "group": "performance",
      "placeholder": {
        "en": "Automatic",
        "zh": "自动"
      },
      "help": {
        "en": "Leave empty to derive the value from the GPU model and performance profile",
        "zh": "留空时按卡型和性能档位推导"
      },
      "engines": [
        "sglang"
      ],
      "automatic": true
    },
    {
      "key": "max_num_seqs",
      "flag": "--max-running-requests",
      "label": {
        "en": "Maximum Concurrent Sequences",
        "zh": "最大并发序列数"
      },
      "type": "integer",
      "control": "number",
      "group": "performance",
      "placeholder": {
        "en": "Automatic",
        "zh": "自动"
      },
      "help": {
        "en": "Leave empty to derive the value from available GPU memory",
        "zh": "留空时按显存容量推导"
      },
      "engines": [
        "sglang"
      ],
      "automatic": true
    },
    {
      "key": "enable_prefix_caching",
      "flag": "--disable-radix-cache",
      "flag_off": "--disable-radix-cache",
      "label": {
        "en": "Prefix Caching",
        "zh": "前缀缓存"
      },
      "type": "boolean",
      "control": "switch",
      "group": "performance",
      "help": {
        "en": "Required for KV Offload",
        "zh": "KV Offload 的前置条件"
      },
      "engines": [
        "sglang"
      ],
      "layout": "quick",
      "order": 33
    },
    {
      "key": "enable_cache_report",
      "flag": "--enable-cache-report",
      "label": {
        "en": "Cache Hit Stats",
        "zh": "返回缓存命中统计"
      },
      "type": "boolean",
      "control": "switch",
      "group": "performance",
      "default": true,
      "help": {
        "en": "Include prefix-cache hit token counts in each response's usage",
        "zh": "开启后推理响应的 usage 携带前缀缓存命中 token 数"
      },
      "engines": [
        "sglang"
      ],
      "layout": "quick",
      "order": 34
    },
    {
      "key": "kv_cache_dtype",
      "flag": "--kv-cache-dtype",
      "label": {
        "en": "KV Cache Precision",
        "zh": "KV Cache 精度"
      },
      "type": "enum",
      "control": "select",
      "group": "performance",
      "enum": [
        "auto",
        "bfloat16",
        "fp8_e4m3",
        "fp8_e5m2",
        "mxfp8",
        "nvfp4",
        "fp4_mx_block16"
      ],
      "options": [
        {
          "value": "auto",
          "label": {
            "en": "Automatic",
            "zh": "自动"
          }
        },
        {
          "value": "bfloat16",
          "label": {
            "en": "BF16",
            "zh": "BF16"
          }
        },
        {
          "value": "fp8_e4m3",
          "label": {
            "en": "FP8 E4M3",
            "zh": "FP8 E4M3"
          }
        },
        {
          "value": "fp8_e5m2",
          "label": {
            "en": "FP8 E5M2",
            "zh": "FP8 E5M2"
          }
        },
        {
          "value": "mxfp8",
          "label": {
            "en": "MXFP8",
            "zh": "MXFP8"
          }
        },
        {
          "value": "nvfp4",
          "label": {
            "en": "NVFP4",
            "zh": "NVFP4"
          }
        },
        {
          "value": "fp4_mx_block16",
          "label": {
            "en": "FP4 MX block-16",
            "zh": "FP4 MX block-16"
          }
        }
      ],
      "default": "auto",
      "placeholder": {
        "en": "auto",
        "zh": "auto"
      },
      "help": {
        "en": "FP8 can significantly increase KV capacity, but requires support from the model and engine version",
        "zh": "FP8 可显著增加 KV 容量，但需模型与引擎版本支持"
      },
      "engines": [
        "sglang"
      ]
    },
    {
      "key": "enforce_eager",
      "flag": "--disable-cuda-graph",
      "label": {
        "en": "Enforce Eager Mode",
        "zh": "强制 Eager"
      },
      "type": "boolean",
      "control": "switch",
      "group": "performance",
      "default": false,
      "help": {
        "en": "Starts faster and uses less GPU memory, but reduces steady-state decoding performance",
        "zh": "启动更快且更省显存，但会降低稳态解码性能"
      },
      "engines": [
        "sglang"
      ],
      "layout": "quick",
      "order": 35
    },
    {
      "key": "speculative_algorithm",
      "flag": "--speculative-algorithm",
      "label": {
        "en": "Speculative Decoding Algorithm",
        "zh": "投机解码算法"
      },
      "type": "enum",
      "control": "select",
      "group": "speculative",
      "enum": [
        "EAGLE",
        "EAGLE3",
        "NEXTN",
        "DSPARK",
        "NGRAM",
        "STANDALONE"
      ],
      "options": [
        {
          "value": "EAGLE",
          "label": {
            "en": "EAGLE",
            "zh": "EAGLE"
          }
        },
        {
          "value": "EAGLE3",
          "label": {
            "en": "EAGLE 3",
            "zh": "EAGLE 3"
          }
        },
        {
          "value": "NEXTN",
          "label": {
            "en": "NextN (MTP)",
            "zh": "NextN（MTP）"
          }
        },
        {
          "value": "DSPARK",
          "label": {
            "en": "DSpark",
            "zh": "DSpark"
          }
        },
        {
          "value": "NGRAM",
          "label": {
            "en": "N-gram",
            "zh": "N-gram"
          }
        },
        {
          "value": "STANDALONE",
          "label": {
            "en": "Standalone Draft Model",
            "zh": "独立草稿模型"
          }
        }
      ],
      "placeholder": {
        "en": "Choose an algorithm",
        "zh": "选择算法"
      },
      "help": {
        "en": "For vLLM the list is only suggestions: type any method name the engine supports and it is passed as written; whether the chosen image supports it is yours to check. For SGLang, choose from the list. For an algorithm that needs a draft, such as DFlash, mount a registered model under Extra Mounts and enter its container path as the draft model.",
        "zh": "vLLM 的列表只是建议，可直接输入引擎支持的任意方法名，原样传给引擎，所选镜像是否支持由部署者自行确认；SGLang 只能从列表中选择。DFlash 等需要 draft 的算法，可在“额外挂载”中挂载一个已注册模型，再把它的容器路径填到 Draft 模型。"
      },
      "engines": [
        "sglang"
      ],
      "layout": "quick",
      "order": 32
    },
    {
      "key": "speculative_draft_model",
      "flag": "--speculative-draft-model-path",
      "label": {
        "en": "Draft Model",
        "zh": "Draft 模型"
      },
      "type": "string",
      "control": "text",
      "group": "speculative",
      "placeholder": {
        "en": "Container path, such as /draft for a model mounted under Extra Mounts; or a model ID",
        "zh": "容器内路径，例如在额外挂载中挂载的模型 /draft；或模型 ID"
      },
      "engines": [
        "sglang"
      ]
    },
    {
      "key": "speculative_tokens",
      "flag": "--speculative-num-draft-tokens",
      "label": {
        "en": "Speculative Tokens per Step",
        "zh": "每步投机 Token 数"
      },
      "type": "integer",
      "control": "number",
      "group": "speculative",
      "min": 1,
      "step": 1,
      "engines": [
        "sglang"
      ]
    },
    {
      "key": "speculative_num_steps",
