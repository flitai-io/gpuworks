  "name": "sglang",
  "default_image": "",
  "health_path": "/health",
  "shm_bytes": 17179869184,
  "metric_path": "/metrics",
  "sleep": {
    "supported": false
  },
  "metric_prefix": "sglang",
  "metric_map": {
    "sglang:cache_hit_rate": "gpuworks_infer_kv_hit_rate_instant",
    "sglang:e2e_request_latency_seconds": "gpuworks_infer_e2e_seconds",
    "sglang:generation_tokens_total": "gpuworks_infer_generation_tokens_total",
    "sglang:inter_token_latency_seconds": "gpuworks_infer_tpot_seconds",
    "sglang:num_queue_reqs": "gpuworks_infer_requests_waiting",
    "sglang:num_requests_running": "gpuworks_infer_requests_running",
    "sglang:num_requests_waiting": "gpuworks_infer_requests_waiting",
    "sglang:num_retracted_requests_total": "gpuworks_infer_preemptions_total",
    "sglang:num_running_reqs": "gpuworks_infer_requests_running",
    "sglang:prompt_tokens_total": "gpuworks_infer_prompt_tokens_total",
    "sglang:queue_time_seconds": "gpuworks_infer_queue_time_seconds",
    "sglang:spec_accept_length": "gpuworks_infer_spec_accept_length",
    "sglang:spec_accept_rate": "gpuworks_infer_spec_accept_rate",
    "sglang:time_to_first_token_seconds": "gpuworks_infer_ttft_seconds",
    "sglang:token_usage": "gpuworks_infer_gpu_cache_usage_percent"
  },
  "param_dict": {
    "data_parallel_size": "--dp-size",
    "dtype": "--dtype",
    "enable_auto_tool_choice": "--enable-auto-tool-choice",
    "enable_cache_report": "--enable-cache-report",
    "enable_metrics": "--enable-metrics",
    "enable_prefix_caching": "--disable-radix-cache",
    "enforce_eager": "--disable-cuda-graph",
    "gpu_memory_utilization": "--mem-fraction-static",
    "kv_cache_dtype": "--kv-cache-dtype",
    "log_level": "--log-level",
    "lora": "--enable-lora",
    "max_model_len": "--context-length",
    "max_num_batched_tokens": "--chunked-prefill-size",
    "max_num_seqs": "--max-running-requests",
    "quantization": "--quantization",
    "reasoning_parser": "--reasoning-parser",
    "speculative_algorithm": "--speculative-algorithm",
    "speculative_draft_model": "--speculative-draft-model-path",
    "speculative_eagle_top_k": "--speculative-eagle-topk",
    "speculative_num_steps": "--speculative-num-steps",
    "speculative_tokens": "--speculative-num-draft-tokens",
    "tool_call_parser": "--tool-call-parser",
    "trust_remote_code": "--trust-remote-code"
  },
  "param_specs": [
    {
      "key": "log_level",
      "flag": "--log-level",
      "aliases": {
        "fatal": "critical",
        "warn": "warning"
      },
      "label": {
        "en": "Log level",
        "zh": "日志级别"
      },
      "type": "enum",
      "control": "select",
      "group": "performance",
      "enum": [
        "debug",
        "info",
        "warning",
        "error",
        "critical",
        "notset"
      ],
      "options": [
        {
          "value": "debug",
          "label": {
            "en": "DEBUG",
            "zh": "DEBUG"
          }
        },
        {
          "value": "info",
          "label": {
            "en": "INFO",
            "zh": "INFO"
          }
        },
        {
          "value": "warning",
          "label": {
            "en": "WARNING",
            "zh": "WARNING"
          }
        },
        {
          "value": "error",
          "label": {
            "en": "ERROR",
            "zh": "ERROR"
          }
        },
        {
          "value": "critical",
          "label": {
            "en": "CRITICAL",
            "zh": "CRITICAL"
          }
        },
        {
          "value": "notset",
          "label": {
            "en": "NOTSET",
            "zh": "NOTSET"
          }
        }
      ],
      "default": "info",
      "help": {
        "en": "Set the log level and include severity in supported SGLang launch logs.",
        "zh": "设置日志级别，并为支持的 SGLang 启动日志补充级别标识。"
      },
      "engines": [
        "sglang"
      ],
      "layout": "quick",
      "order": 36
    },
    {
      "key": "enable_metrics",
      "flag": "--enable-metrics",
      "label": {
        "en": "Enable Inference Metrics",
        "zh": "推理监控指标"
      },
      "type": "boolean",
      "control": "switch",
      "group": "performance",
      "default": true,
      "help": {
        "en": "Expose engine inference metrics for GPUWorks monitoring",
        "zh": "向 GPUWorks 提供引擎推理指标；关闭后无法查看实例级推理监控数据"
      },
      "engines": [
        "sglang"
      ],
      "layout": "quick",
      "order": 37
    },
    {
      "key": "max_model_len",
      "flag": "--context-length",
      "label": {
        "en": "Maximum Context Length",
        "zh": "最大上下文长度"
      },
      "type": "integer",
      "control": "number",
      "group": "model",
      "placeholder": {
        "en": "Automatic",
        "zh": "自动"
      },
      "help": {
        "en": "Specify a fixed length, or choose automatic memory fitting on supported vLLM versions. The model limit is not the observed runtime limit.",
        "zh": "可指定固定长度；支持的 vLLM 版本可选择自动按可用内存适配。模型上限不等于实际可用长度。"
      },
      "engines": [
        "sglang"
      ],
      "automatic": true,
      "layout": "quick",
      "order": 10
    },
    {
      "key": "dtype",
      "flag": "--dtype",
      "aliases": {
        "float": "float32",
        "half": "float16"
      },
      "label": {
        "en": "Weight Precision",
        "zh": "权重精度"
      },
      "type": "enum",
      "control": "select",
      "group": "model",
      "enum": [
        "auto",
        "float16",
        "bfloat16",
        "float32"
      ],
      "options": [
        {
          "value": "auto",
          "label": {
            "en": "Automatic",
            "zh": "自动"
          }
        },
        {
          "value": "float16",
          "label": {
            "en": "Float16",
            "zh": "Float16"
          }
        },
        {
          "value": "bfloat16",
          "label": {
            "en": "BFloat16",
            "zh": "BFloat16"
          }
        },
        {
          "value": "float32",
          "label": {
            "en": "Float32",
            "zh": "Float32"
          }
        }
      ],
      "default": "auto",
      "engines": [
        "sglang"
      ]
    },
    {
      "key": "quantization",
      "flag": "--quantization",
      "label": {
        "en": "Quantization Method",
        "zh": "量化方式"
      },
      "type": "string",
      "control": "text",
      "group": "model",
      "placeholder": {
        "en": "For example, awq",
        "zh": "例如 awq"
      },
      "help": {
        "en": "The quantization format is determined jointly by the model and image",
        "zh": "量化格式由模型和镜像共同决定"
      },
      "engines": [
        "sglang"
      ]
    },
    {
      "key": "trust_remote_code",
      "flag": "--trust-remote-code",
      "label": {
        "en": "Trust Remote Code",
        "zh": "信任远程代码"
      },
      "type": "boolean",
      "control": "switch",
      "group": "model",
      "default": false,
      "help": {
        "en": "Allow custom code from the model repository to be loaded",
        "zh": "允许加载模型仓库中的自定义代码"
      },
      "engines": [
        "sglang"
      ]
    },
