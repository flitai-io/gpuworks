      "async": {
        "id_field": "id",
        "status_field": "status",
        "success_statuses": [
          "completed"
        ],
        "failure_statuses": [
          "failed",
          "cancelled",
          "deleted"
        ],
        "poll_method": "GET",
        "poll_endpoint": "{endpoint}/{id}",
        "content_method": "GET",
        "content_endpoint": "{endpoint}/{id}/content",
        "cancel_method": "DELETE",
        "cancel_endpoint": "{endpoint}/{id}"
      }
    },
