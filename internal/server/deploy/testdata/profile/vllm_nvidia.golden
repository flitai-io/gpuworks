    {
      "key": "enable_auto_tool_choice",
      "flag": "--enable-auto-tool-choice",
      "label": {
        "en": "Automatic Tool Selection",
        "zh": "自动选择工具"
      },
      "type": "boolean",
      "control": "switch",
      "group": "model",
      "default": false,
      "help": {
        "en": "Allow the model to select tools automatically for each request",
        "zh": "允许模型根据请求自动选择工具"
      },
      "engines": [
        "vllm"
      ]
    },
    {
      "key": "limit_mm_per_prompt",
      "flag": "--limit-mm-per-prompt",
      "label": {
        "en": "Media Limit per Request",
        "zh": "每请求媒体上限"
      },
      "type": "json",
      "control": "json",
      "group": "multimodal",
      "placeholder": {
        "en": "{\"image\":2,\"audio\":1}",
        "zh": "{\"image\":2,\"audio\":1}"
      },
      "engines": [
        "vllm"
      ],
      "multimodal_only": true
    },
    {
      "key": "mm_processor_kwargs",
      "flag": "--mm-processor-kwargs",
      "label": {
        "en": "Multimodal Processor Parameters",
        "zh": "多模态处理器参数"
      },
      "type": "json",
      "control": "json",
      "group": "multimodal",
      "placeholder": {
        "en": "{\"max_dynamic_patch\":12}",
        "zh": "{\"max_dynamic_patch\":12}"
      },
      "engines": [
        "vllm"
      ],
      "multimodal_only": true
    },
    {
      "key": "media_io_kwargs",
      "flag": "--media-io-kwargs",
      "label": {
        "en": "Media I/O Parameters",
        "zh": "媒体 I/O 参数"
      },
      "type": "json",
      "control": "json",
      "group": "multimodal",
      "placeholder": {
        "en": "{\"video\":{\"num_frames\":16}}",
        "zh": "{\"video\":{\"num_frames\":16}}"
      },
      "engines": [
        "vllm"
      ],
      "multimodal_only": true
    },
    {
      "key": "allowed_local_media_path",
      "flag": "--allowed-local-media-path",
      "label": {
        "en": "Allowed Local Media Path",
        "zh": "允许本地媒体路径"
      },
      "type": "string",
      "control": "path",
      "group": "multimodal",
      "placeholder": {
        "en": "/model/media",
        "zh": "/model/media"
      },
      "help": {
        "en": "An absolute, non-root path inside the container",
        "zh": "容器内绝对非根路径"
      },
      "engines": [
        "vllm"
      ],
      "multimodal_only": true
    },
    {
      "key": "performance_mode",
      "flag": "--performance-mode",
      "label": {
        "en": "Performance Profile",
        "zh": "性能档位"
      },
      "type": "enum",
      "control": "segmented",
      "group": "performance",
      "enum": [
        "interactivity",
        "balanced",
        "throughput"
      ],
      "options": [
        {
          "value": "interactivity",
          "label": {
            "en": "Low Latency",
            "zh": "低延迟"
          }
        },
        {
          "value": "balanced",
          "label": {
            "en": "Balanced",
            "zh": "均衡"
          }
        },
        {
          "value": "throughput",
          "label": {
            "en": "High Throughput",
            "zh": "高吞吐"
          }
        }
      ],
      "default": "balanced",
      "engines": [
        "vllm"
      ]
    },
    {
      "key": "gpu_memory_utilization",
      "flag": "--gpu-memory-utilization",
      "label": {
        "en": "GPU Memory Utilization",
        "zh": "显存使用率"
      },
      "type": "number",
      "control": "slider",
      "group": "performance",
      "default": 0.9,
      "min": 0.01,
      "max": 0.98,
      "step": 0.01,
      "help": {
        "en": "Per-GPU memory limit for this instance; divide capacity manually when multiple instances share a GPU",
        "zh": "本实例的每卡显存上限；同卡多实例时需自行分摊"
      },
      "engines": [
        "vllm"
      ],
      "layout": "quick",
      "order": 11
    },
    {
      "key": "enable_chunked_prefill",
      "flag": "--enable-chunked-prefill",
      "flag_off": "--no-enable-chunked-prefill",
      "label": {
        "en": "Chunked Prefill",
        "zh": "分块预填充"
      },
      "type": "boolean",
      "control": "switch",
      "group": "performance",
      "help": {
        "en": "When disabled, the maximum batched token count cannot be smaller than the context length",
        "zh": "关闭时单批最大 Token 数不得小于上下文长度"
      },
      "engines": [
        "vllm"
      ],
      "layout": "quick",
      "order": 38
    },
    {
      "key": "max_num_batched_tokens",
      "flag": "--max-num-batched-tokens",
      "label": {
        "en": "Maximum Batched Tokens",
        "zh": "单批最大 Token 数"
      },
      "type": "integer",
      "control": "number",
      "group": "performance",
      "placeholder": {
        "en": "Automatic",
        "zh": "自动"
      },
      "help": {
        "en": "Leave empty to derive the value from the GPU model and performance profile",
        "zh": "留空时按卡型和性能档位推导"
      },
      "engines": [
        "vllm"
      ],
      "automatic": true
    },
    {
      "key": "max_num_seqs",
      "flag": "--max-num-seqs",
      "label": {
        "en": "Maximum Concurrent Sequences",
        "zh": "最大并发序列数"
      },
      "type": "integer",
      "control": "number",
      "group": "performance",
      "placeholder": {
        "en": "Automatic",
        "zh": "自动"
      },
      "help": {
        "en": "Leave empty to derive the value from available GPU memory",
        "zh": "留空时按显存容量推导"
      },
      "engines": [
        "vllm"
      ],
      "automatic": true
    },
    {
      "key": "enable_prefix_caching",
      "flag": "--enable-prefix-caching",
      "flag_off": "--no-enable-prefix-caching",
      "label": {
        "en": "Prefix Caching",
        "zh": "前缀缓存"
      },
      "type": "boolean",
      "control": "switch",
      "group": "performance",
      "help": {
        "en": "Required for KV Offload",
        "zh": "KV Offload 的前置条件"
      },
      "engines": [
        "vllm"
      ],
      "layout": "quick",
      "order": 33
    },
    {
      "key": "enable_cache_report",
      "flag": "--enable-prompt-tokens-details",
      "label": {
        "en": "Cache Hit Stats",
        "zh": "返回缓存命中统计"
      },
      "type": "boolean",
      "control": "switch",
      "group": "performance",
      "default": true,
      "help": {
        "en": "Include prefix-cache hit token counts in each response's usage",
        "zh": "开启后推理响应的 usage 携带前缀缓存命中 token 数"
      },
      "engines": [
        "vllm"
      ],
      "layout": "quick",
      "order": 34
    },
    {
      "key": "enable_request_metrics",
      "flag": "--enable-per-request-metrics",
      "label": {
        "en": "Per-request Timings",
        "zh": "返回逐请求耗时"
      },
      "type": "boolean",
      "control": "switch",
      "group": "performance",
      "default": true,
      "help": {
        "en": "The last event of each response also carries the request's queue, prefill and decode times, which the monitor's request view shows. Takes effect on images known to run vLLM 0.25.0 or later; other images start without it.",
        "zh": "开启后每个推理响应的最后一个事件同时携带该请求的排队、Prefill 与 Decode 耗时，监控中心的请求视图据此拆分各阶段。仅对已知为 vLLM 0.25.0 及以上的镜像生效，其余镜像不带此参数启动。"
      },
      "engines": [
        "vllm"
      ],
      "layout": "quick",
      "order": 39
    },
