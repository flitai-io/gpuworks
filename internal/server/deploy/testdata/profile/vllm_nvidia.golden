        "zh": "异步调度"
      },
      "type": "boolean",
      "control": "switch",
      "group": "performance_advanced",
      "default": false,
      "engines": [
        "vllm"
      ],
      "advanced": true
    },
    {
      "key": "long_prefill_token_threshold",
      "flag": "--long-prefill-token-threshold",
      "label": {
        "en": "Long Prefill Token Threshold",
        "zh": "长预填充阈值"
      },
      "type": "integer",
      "control": "number",
      "group": "performance_advanced",
