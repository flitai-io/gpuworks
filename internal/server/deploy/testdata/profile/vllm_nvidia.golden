  "name": "vllm",
  "default_image": "vllm/vllm-openai:latest",
  "health_path": "/health",
  "shm_bytes": 17179869184,
  "metric_path": "/metrics",
  "sleep": {
    "supported": true,
    "levels": [
      "L1",
      "L2"
    ]
  },
  "metric_prefix": "vllm",
  "metric_map": {
    "vllm:e2e_request_latency_seconds": "gpuworks_infer_e2e_seconds",
    "vllm:generation_tokens_total": "gpuworks_infer_generation_tokens_total",
    "vllm:gpu_cache_usage_perc": "gpuworks_infer_gpu_cache_usage_percent",
    "vllm:inter_token_latency_seconds": "gpuworks_infer_tpot_seconds",
    "vllm:kv_cache_usage_perc": "gpuworks_infer_gpu_cache_usage_percent",
    "vllm:kv_offload_tiering_cascade_job_failures_total{tier=\"1:fs\"}": "gpuworks_infer_kv_disk_write_failures_total",
    "vllm:kv_offload_tiering_chunk_hits_total{tier=\"0:primary\"}": "gpuworks_infer_kv_memory_hits_total",
    "vllm:kv_offload_tiering_chunk_hits_total{tier=\"1:fs\"}": "gpuworks_infer_kv_disk_hits_total",
    "vllm:kv_offload_tiering_chunk_queries_total{tier=\"0:primary\"}": "gpuworks_infer_kv_memory_queries_total",
    "vllm:kv_offload_tiering_chunk_queries_total{tier=\"1:fs\"}": "gpuworks_infer_kv_disk_queries_total",
    "vllm:kv_offload_tiering_write_bytes_total{tier=\"1:fs\"}": "gpuworks_infer_kv_disk_write_bytes_total",
    "vllm:nixl_bytes_transferred": "gpuworks_infer_nixl_transfer_bytes",
    "vllm:nixl_num_failed_transfers_total": "gpuworks_infer_nixl_failed_transfers_total",
    "vllm:nixl_num_kv_expired_reqs_total": "gpuworks_infer_nixl_kv_expired_total",
    "vllm:nixl_xfer_time_seconds": "gpuworks_infer_nixl_transfer_seconds",
    "vllm:num_preemptions_total": "gpuworks_infer_preemptions_total",
    "vllm:num_requests_running": "gpuworks_infer_requests_running",
    "vllm:num_requests_waiting": "gpuworks_infer_requests_waiting",
    "vllm:prefix_cache_hits_total": "gpuworks_infer_kv_hits_total",
    "vllm:prefix_cache_queries_total": "gpuworks_infer_kv_queries_total",
    "vllm:prompt_tokens_by_source_total{source=\"external_kv_transfer\"}": "gpuworks_infer_prompt_tokens_external_total",
    "vllm:prompt_tokens_by_source_total{source=\"local_cache_hit\"}": "gpuworks_infer_prompt_tokens_cache_hit_total",
    "vllm:prompt_tokens_by_source_total{source=\"local_compute\"}": "gpuworks_infer_prompt_tokens_local_compute_total",
    "vllm:prompt_tokens_total": "gpuworks_infer_prompt_tokens_total",
    "vllm:request_decode_time_seconds": "gpuworks_infer_decode_time_seconds",
    "vllm:request_prefill_time_seconds": "gpuworks_infer_prefill_time_seconds",
    "vllm:request_queue_time_seconds": "gpuworks_infer_queue_time_seconds",
    "vllm:request_success_total": "gpuworks_infer_requests_success_total",
    "vllm:spec_decode_num_accepted_tokens_total": "gpuworks_infer_spec_accepted_tokens_total",
    "vllm:spec_decode_num_draft_tokens_total": "gpuworks_infer_spec_draft_tokens_total",
    "vllm:time_per_output_token_seconds": "gpuworks_infer_tpot_seconds",
    "vllm:time_to_first_token_seconds": "gpuworks_infer_ttft_seconds"
  },
  "param_dict": {
    "allowed_local_media_path": "--allowed-local-media-path",
    "api_server_count": "--api-server-count",
    "async_scheduling": "--async-scheduling",
    "cpu_offload_gb": "--cpu-offload-gb",
    "data_parallel_size": "--data-parallel-size",
    "dtype": "--dtype",
    "enable_auto_tool_choice": "--enable-auto-tool-choice",
    "enable_cache_report": "--enable-prompt-tokens-details",
    "enable_chunked_prefill": "--enable-chunked-prefill",
    "enable_prefix_caching": "--enable-prefix-caching",
    "enable_request_metrics": "--enable-per-request-metrics",
    "enforce_eager": "--enforce-eager",
    "gpu_memory_utilization": "--gpu-memory-utilization",
    "kv_cache_dtype": "--kv-cache-dtype",
    "kv_cache_memory_bytes": "--kv-cache-memory-bytes",
    "kv_disk_offload": "--kv-transfer-config",
    "kv_offload_read_threads": "--kv-transfer-config",
    "kv_offload_write_threads": "--kv-transfer-config",
    "kv_offloading_size": "--kv-offloading-size",
    "limit_mm_per_prompt": "--limit-mm-per-prompt",
    "long_prefill_token_threshold": "--long-prefill-token-threshold",
    "lora": "--enable-lora",
    "max_cudagraph_capture_size": "--max-cudagraph-capture-size",
    "max_model_len": "--max-model-len",
    "max_num_batched_tokens": "--max-num-batched-tokens",
    "max_num_seqs": "--max-num-seqs",
    "media_io_kwargs": "--media-io-kwargs",
    "mm_encoder_tp_mode": "--mm-encoder-tp-mode",
    "mm_processor_kwargs": "--mm-processor-kwargs",
    "optimization_level": "-O",
    "performance_mode": "--performance-mode",
    "prefix_caching_hash_algo": "--prefix-caching-hash-algo",
    "quantization": "--quantization",
    "reasoning_parser": "--reasoning-parser",
    "rope_scaling": "--rope-scaling",
    "shared_kv_dir": "--kv-transfer-config",
    "speculative_algorithm": "--speculative-config",
    "speculative_draft_model": "--speculative-config",
    "speculative_tokens": "--speculative-config",
    "stream_interval": "--stream-interval",
    "tool_call_parser": "--tool-call-parser",
    "trust_remote_code": "--trust-remote-code",
    "watermark": "--watermark"
  },
  "param_specs": [
    {
      "key": "max_model_len",
      "flag": "--max-model-len",
      "label": {
        "en": "Maximum Context Length",
        "zh": "最大上下文长度"
      },
      "type": "integer",
      "control": "number",
      "group": "model",
      "default": -1,
      "placeholder": {
        "en": "Automatic",
        "zh": "自动"
      },
      "help": {
        "en": "Specify a fixed length, or choose automatic memory fitting on supported vLLM versions. The model limit is not the observed runtime limit.",
        "zh": "可指定固定长度；支持的 vLLM 版本可选择自动按可用内存适配。模型上限不等于实际可用长度。"
      },
      "engines": [
        "vllm"
      ],
      "automatic": true,
      "layout": "quick",
      "order": 10
    },
    {
      "key": "dtype",
      "flag": "--dtype",
      "aliases": {
        "float": "float32",
        "half": "float16"
      },
      "label": {
        "en": "Weight Precision",
        "zh": "权重精度"
      },
      "type": "enum",
      "control": "select",
      "group": "model",
      "enum": [
        "auto",
        "float16",
        "bfloat16",
        "float32"
      ],
      "options": [
        {
          "value": "auto",
          "label": {
            "en": "Automatic",
            "zh": "自动"
          }
        },
        {
          "value": "float16",
          "label": {
            "en": "Float16",
            "zh": "Float16"
          }
        },
        {
          "value": "bfloat16",
          "label": {
            "en": "BFloat16",
            "zh": "BFloat16"
          }
        },
        {
          "value": "float32",
          "label": {
            "en": "Float32",
            "zh": "Float32"
          }
        }
      ],
      "default": "auto",
      "engines": [
        "vllm"
      ]
    },
    {
      "key": "quantization",
      "flag": "--quantization",
      "label": {
        "en": "Quantization Method",
        "zh": "量化方式"
      },
      "type": "string",
      "control": "text",
      "group": "model",
      "placeholder": {
        "en": "For example, awq",
        "zh": "例如 awq"
      },
      "help": {
        "en": "The quantization format is determined jointly by the model and image",
        "zh": "量化格式由模型和镜像共同决定"
      },
      "engines": [
        "vllm"
      ]
    },
    {
      "key": "rope_scaling",
      "flag": "--rope-scaling",
      "label": {
        "en": "RoPE Scaling",
        "zh": "RoPE scaling"
      },
      "type": "json",
      "control": "json",
      "group": "model",
      "placeholder": {
        "en": "{\"rope_type\":\"yarn\",\"factor\":2}",
        "zh": "{\"rope_type\":\"yarn\",\"factor\":2}"
      },
      "engines": [
        "vllm"
      ]
    },
    {
      "key": "trust_remote_code",
      "flag": "--trust-remote-code",
      "label": {
        "en": "Trust Remote Code",
        "zh": "信任远程代码"
      },
      "type": "boolean",
      "control": "switch",
      "group": "model",
      "default": false,
      "help": {
        "en": "Allow custom code from the model repository to be loaded",
        "zh": "允许加载模型仓库中的自定义代码"
      },
      "engines": [
        "vllm"
      ]
    },
    {
      "key": "reasoning_parser",
      "flag": "--reasoning-parser",
      "label": {
        "en": "Reasoning Content Parser",
        "zh": "推理内容解析器"
      },
