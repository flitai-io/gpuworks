[
  "vllm",
  "serve",
  "/model",
  "--served-model-name",
  "qwen3-8b",
  "--host",
  "0.0.0.0",
  "--port",
  "30000",
  "--tensor-parallel-size",
  "1",
  "--enable-chunked-prefill",
  "--enable-prefix-caching",
  "--enable-prompt-tokens-details",
  "--enable-per-request-metrics",
  "--performance-mode",
  "throughput",
  "--max-model-len",
  "1",
  "--dtype",
  "float32",
  "--kv-cache-dtype",
  "ultraquant_4bit",
  "--gpu-memory-utilization",
  "0.98",
  "--max-num-seqs",
  "1",
  "--max-num-batched-tokens",
  "1",
  "--long-prefill-token-threshold",
  "1",
  "--kv-transfer-config",
  "{\"kv_connector\":\"OffloadingConnector\",\"kv_connector_extra_config\":{\"cpu_bytes_to_use\":1073741824,\"secondary_tiers\":[{\"n_read_threads\":1,\"n_write_threads\":1,\"root_dir\":\"example\",\"type\":\"fs\"}],\"spec_name\":\"TieringOffloadingSpec\"},\"kv_role\":\"kv_both\"}",
  "--kv-cache-memory-bytes",
  "1",
  "--prefix-caching-hash-algo",
  "xxhash",
  "--speculative-config",
  "{\"method\":\"example\",\"model\":\"example\",\"num_speculative_tokens\":1}",
  "-O3",
  "--async-scheduling",
  "--cpu-offload-gb",
  "1",
  "--stream-interval",
  "1",
  "--watermark",
  "1",
  "--max-cudagraph-capture-size",
  "1",
  "--mm-encoder-tp-mode",
  "data",
  "--api-server-count",
  "1",
  "--data-parallel-size",
  "1",
  "--enable-lora",
  "--quantization",
  "example",
  "--rope-scaling",
  "{\"kind\":\"example\"}",
  "--trust-remote-code",
  "--enforce-eager",
  "--reasoning-parser",
  "example",
  "--tool-call-parser",
  "example",
  "--enable-auto-tool-choice",
  "--limit-mm-per-prompt",
  "{\"kind\":\"example\"}",
  "--mm-processor-kwargs",
  "{\"kind\":\"example\"}",
  "--media-io-kwargs",
  "{\"kind\":\"example\"}",
  "--allowed-local-media-path",
  "example"
