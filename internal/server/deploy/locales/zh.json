    "label": "媒体 I/O 参数",
    "placeholder": "{\"video\":{\"num_frames\":16}}"
  },
  "allowed_local_media_path": {
    "label": "允许本地媒体路径",
    "placeholder": "/model/media",
    "help": "容器内绝对非根路径"
  },
  "performance_mode": {
    "label": "性能档位",
    "options": {
      "interactivity": "低延迟",
      "balanced": "均衡",
      "throughput": "高吞吐"
    }
  },
  "gpu_memory_utilization": {
    "label": "显存使用率",
    "help": "本实例的每卡显存上限；同卡多实例时需自行分摊"
  },
  "enable_chunked_prefill": {
    "label": "分块预填充",
    "help": "关闭时单批最大 Token 数不得小于上下文长度"
  },
  "max_num_batched_tokens": {
    "label": "单批最大 Token 数",
    "placeholder": "自动",
    "help": "留空时按卡型和性能档位推导"
  },
  "max_num_seqs": {
    "label": "最大并发序列数",
    "placeholder": "自动",
    "help": "留空时按显存容量推导"
  },
  "enable_prefix_caching": {
    "label": "前缀缓存",
    "help": "KV Offload 的前置条件"
  },
  "enable_cache_report": {
    "label": "返回缓存命中统计",
    "help": "开启后推理响应的 usage 携带前缀缓存命中 token 数"
  },
  "enable_request_metrics": {
    "label": "返回逐请求耗时",
    "help": "开启后每个推理响应的最后一个事件同时携带该请求的排队、Prefill 与 Decode 耗时，监控中心的请求视图据此拆分各阶段。仅对已知为 vLLM 0.25.0 及以上的镜像生效，其余镜像不带此参数启动。"
  },
  "kv_cache_dtype": {
    "label": "KV Cache 精度",
    "placeholder": "auto",
    "help": "FP8 可显著增加 KV 容量，但需模型与引擎版本支持",
    "options": {
      "auto": "自动",
      "float16": "FP16",
      "bfloat16": "BF16",
      "fp8": "FP8",
      "fp8_e4m3": "FP8 E4M3",
      "fp8_e5m2": "FP8 E5M2",
      "fp8_inc": "FP8 (INC)",
      "fp8_per_token_head": "FP8 per-token-head",
      "fp8_ds_mla": "FP8 DeepSeek MLA",
      "nvfp4": "NVFP4",
      "nvfp4_4over6": "NVFP4 4/6",
      "nvfp4_ds_mla": "NVFP4 DeepSeek MLA",
      "int8": "INT8",
      "int8_per_token_head": "INT8 per-token-head",
      "int4_per_token_head": "INT4 per-token-head",
      "turboquant_k8v4": "TurboQuant K8V4",
      "turboquant_4bit_nc": "TurboQuant 4-bit",
      "turboquant_k3v4_nc": "TurboQuant K3V4",
      "turboquant_3bit_nc": "TurboQuant 3-bit",
      "ultraquant_4bit": "UltraQuant 4-bit",
      "mxfp8": "MXFP8",
      "fp4_mx_block16": "FP4 MX block-16"
    }
  },
  "kv_offloading_size": {
    "label": "KV Offload 到内存",
    "help": "所有 GPU 的内存层总量（GiB），不是每卡容量"
  },
  "kv_disk_offload": {
    "label": "KV Offload 到磁盘",
    "help": "磁盘层经内存层中转，必须先配置内存层"
  },
  "shared_kv_dir": {
    "label": "共享 KV 目录",
    "placeholder": "/data/gpuworks/kv-cache",
    "help": "平台会在该容器路径挂载一个受管宿主机目录，并把它控制在磁盘层容量上限之内。"
  },
  "kv_offload_read_threads": {
    "label": "磁盘读取线程"
  },
  "kv_offload_write_threads": {
    "label": "磁盘写入线程"
  },
  "kv_disk_limit_gib": {
    "label": "磁盘层容量上限（GiB）",
    "placeholder": "模型权重的两倍",
    "help": "平台对磁盘层目录施加的容量上限，引擎自身没有上限。留空则由平台按模型权重推导。"
  },
  "enforce_eager": {
    "label": "强制 Eager",
    "help": "启动更快且更省显存，但会降低稳态解码性能"
  },
  "speculative_algorithm": {
    "label": "投机解码算法",
    "placeholder": "选择算法",
    "help": "vLLM 的列表只是建议，可直接输入引擎支持的任意方法名，原样传给引擎，所选镜像是否支持由部署者自行确认；SGLang 只能从列表中选择。DFlash 等需要 draft 的算法，可在“额外挂载”中挂载一个已注册模型，再把它的容器路径填到 Draft 模型。",
    "options": {
      "eagle": "EAGLE",
      "eagle3": "EAGLE 3",
      "mtp": "MTP",
      "ngram": "N-gram",
      "draft_model": "Draft 模型",
      "dflash": "DFlash",
      "dspark": "DSpark",
      "EAGLE": "EAGLE",
      "EAGLE3": "EAGLE 3",
      "NEXTN": "NextN（MTP）",
      "DSPARK": "DSpark",
      "NGRAM": "N-gram",
      "STANDALONE": "独立草稿模型"
    }
  },
  "speculative_draft_model": {
