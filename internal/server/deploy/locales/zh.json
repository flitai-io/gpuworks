  "enable_auto_tool_choice": {
    "label": "自动选择工具",
    "help": "允许模型根据请求自动选择工具"
  },
  "limit_mm_per_prompt": {
    "label": "每请求媒体上限",
    "placeholder": "{\"image\":2,\"audio\":1}"
  },
  "mm_processor_kwargs": {
    "label": "多模态处理器参数",
    "placeholder": "{\"max_dynamic_patch\":12}"
  },
