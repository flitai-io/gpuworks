+    def _register_hybrid_page_caches(self, kv_caches: dict[str, torch.Tensor]):
+        """Register each hybrid KV cache tensor once, as num_blocks pages."""
+        if self.pp_size != 1:
+            raise ValueError(
+                "MooncakeConnector supports Mamba/GDN hybrid models at "
+                f"pipeline parallel size 1 only, got {self.pp_size}."
+            )
+        assert self.kv_cache_config is not None
+        num_blocks = self.kv_cache_config.num_blocks
+        base_addrs: list[int] = []
+        sizes: list[int] = []
+        self.cache_entry_model_layer = []
+        self.cache_entry_layer_names = []
+        self.model_layer_to_cache_indices = {}
+        for kv_cache_tensor in self.kv_cache_config.kv_cache_tensors:
+            layer_name = next(
+                (name for name in kv_cache_tensor.shared_by if name in kv_caches),
+                None,
+            )
+            if layer_name is None:
+                continue
+            value = kv_caches[layer_name]
+            view = value[0] if isinstance(value, (list, tuple)) else value
+            storage = view.untyped_storage()
+            size = storage.nbytes()
+            if size % num_blocks != 0:
+                raise ValueError(
+                    f"KV cache tensor of {layer_name} has {size} bytes, not a "
+                    f"multiple of {num_blocks} blocks."
+                )
+            base_addrs.append(storage.data_ptr())
+            sizes.append(size)
+            model_layer = _parse_model_layer_index(layer_name)
+            self.cache_entry_model_layer.append(model_layer)
+            self.cache_entry_layer_names.append(layer_name)
+            self.model_layer_to_cache_indices.setdefault(model_layer, []).append(
+                len(base_addrs) - 1
+            )
+        if not base_addrs:
+            raise RuntimeError("No KV cache tensors were registered with Mooncake.")
+        page_lens = [size // num_blocks for size in sizes]
+        if len(set(page_lens)) != 1:
+            raise ValueError(
+                f"Hybrid KV cache tensors differ in page size: {sorted(set(page_lens))}"
+            )
+
+        ret_value = self.engine.batch_register_memory(base_addrs, sizes)
+        if ret_value != 0:
+            raise RuntimeError("Mooncake batch memory registration failed.")
+
+        self.num_blocks = num_blocks
+        self.kv_caches_base_addr = base_addrs
+        self.seen_base_addresses = base_addrs
+        self.block_len_per_layer = page_lens
+        self.slot_size_bytes_per_layer = []
+        self.block_len = page_lens[0]
+        # Handshake checks compare it between the two sides; a page is the unit.
+        self.slot_size_bytes = page_lens[0]
+        self.device_kv_caches = kv_caches
+        logger.info(
+            "Mooncake hybrid KV registered: num_blocks=%d page_len=%d tensors=%d",
+            num_blocks,
+            page_lens[0],
+            len(base_addrs),
+        )
+
+        # No need to launch server for D node.
         if self.is_kv_consumer:
