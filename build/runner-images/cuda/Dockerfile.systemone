# gpuworks-runner: NVIDIA CUDA System One 决策模型线
#
# System One 决策模型（Intern-Decision 等“开源版 Jev”）不生成文本：一次前向给每个问题的候选打分。
# 它们没有 vLLM / SGLang 实现，推理代码随权重仓库（inference.py）走原生 Hugging Face
# Transformers，平台用 callable 引擎 + 模板资产里的 gpuworks_serve.py / systemone_adapter.py
# 对外提供 /v1/systemone。本镜像只提供它们共用的 Python 栈，不内置 adapter：
# adapter 随模板资产发布，改它不用重打镜像。
#
# 内容 = Ubuntu 24.04（自带 Python 3.12；inference.py 用了 3.12 的 f-string 语法。不用 nvidia/cuda：
#          torch 的 cu128 wheel 自带 CUDA 运行时，驱动库由容器运行时注入）
#       + Python 3.12 venv（/opt/venv 在 PATH 上，python3 指向它）
#       + torch / torchvision（CUDA 12.8 构建，先单独装并断言）
#       + transformers（Qwen3.5 的 Qwen3_5ForConditionalGeneration）+ Pillow
# 版本照 Intern-Decision 的 requirements.txt 钉死。
#
# 刻意没有：nvcc（不即时编译内核）、vllm / sglang、补丁层。
ARG BASE_IMAGE=docker.io/library/ubuntu:24.04
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

ARG ENGINE_VERSION=1.0
ARG FRAMEWORK_VERSION=12.8
ARG TORCH_VERSION=2.9.1
ARG TORCHVISION_VERSION=0.24.1
ARG TRANSFORMERS_VERSION=5.14.1
# torch 的 CUDA 12.8 构建所在的 find-links 目录（阿里云镜像；直连 download.pytorch.org 在国内很慢）。
ARG TORCH_FIND_LINKS=https://mirrors.aliyun.com/pytorch-wheels/cu128/
ARG IMAGE_ID=unknown
ARG IMAGE_REVISION=unknown
ARG REQUIRES="systemone"
# 构建期源：ARG 而非 ENV，不写进运行期镜像（理由同 Dockerfile.vllm）。
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_DEFAULT_TIMEOUT=60
ARG APT_MIRROR=mirrors.aliyun.com

# NVIDIA 容器运行时按这两个变量注入 GPU 与驱动库（nvidia/cuda 基础镜像自带它们，纯 Ubuntu 要自己写）。
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

## 工具层
#
# apt 源的镜像改写只在构建期生效：装完还原，不把镜像源留给用户。
RUN <<EOF
    set -eux
    mkdir -p /tmp/apt-backup
    cp -a /etc/apt/sources.list /tmp/apt-backup/ 2>/dev/null || true
    cp -a /etc/apt/sources.list.d /tmp/apt-backup/ 2>/dev/null || true
    sed -i \
        -e "s|archive.ubuntu.com/ubuntu|${APT_MIRROR}/ubuntu|g" \
        -e "s|security.ubuntu.com/ubuntu|${APT_MIRROR}/ubuntu|g" \
        /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true
    apt-get update -y
    apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv \
        tini jq curl ca-certificates less procps iproute2
    rm -rf /etc/apt/sources.list /etc/apt/sources.list.d
    cp -a /tmp/apt-backup/sources.list /etc/apt/ 2>/dev/null || true
    cp -a /tmp/apt-backup/sources.list.d /etc/apt/ 2>/dev/null || true
    rm -rf /tmp/apt-backup /var/lib/apt/lists/* /var/cache/apt /var/tmp/* /tmp/*
EOF

RUN python3.12 -m venv /opt/venv
ENV PATH=/opt/venv/bin:${PATH}

## torch：先单独装 CUDA 12.8 构建，并当场断言
RUN <<EOF
    set -eux
    pip install --no-cache-dir -i "${PIP_INDEX_URL}" -U pip
    pip install --no-cache-dir -i "${PIP_INDEX_URL}" -f "${TORCH_FIND_LINKS}" \
        "torch==${TORCH_VERSION}+cu128" "torchvision==${TORCHVISION_VERSION}+cu128"
    python -c "
import torch
assert torch.__version__.split('+')[0] == '${TORCH_VERSION}', torch.__version__
assert torch.version.cuda == '${FRAMEWORK_VERSION}', torch.version.cuda
print('torch', torch.__version__, 'cuda', torch.version.cuda)"
    pip freeze | grep -E '^(torch|torchvision|triton|nvidia-[^=]*)==' | sort > /tmp/torch-stack.txt
EOF

## transformers + Pillow：不许改动上面钉住的 torch 栈
RUN <<EOF
    set -eux
    pip install --no-cache-dir -i "${PIP_INDEX_URL}" \
        "transformers==${TRANSFORMERS_VERSION}" "Pillow>=10.0.0"
    pip freeze | grep -E '^(torch|torchvision|triton|nvidia-[^=]*)==' | sort > /tmp/torch-stack.after
    changed="$(comm -23 /tmp/torch-stack.txt /tmp/torch-stack.after)"
    test -z "${changed}" || { echo "transformers changed the pinned torch stack:" >&2; echo "${changed}" >&2; exit 1; }
    rm -f /tmp/torch-stack.txt /tmp/torch-stack.after
    pip check
EOF

## 自描述清单 + requires 断言
COPY shared/assert_requires.sh /opt/gpuworks/shared/assert_requires.sh
RUN <<EOF
    set -eux
    python - <<'PY' > /opt/gpuworks/image.json
import json, os
json.dump({
    "id": os.environ["IMAGE_ID"],
    "revision": os.environ["IMAGE_REVISION"],
    "engine": "systemone",
    "engine_version": os.environ["ENGINE_VERSION"],
    "framework": "cuda",
    "framework_version": os.environ["FRAMEWORK_VERSION"],
    "requires": os.environ["REQUIRES"].split(),
    "torch": os.environ["TORCH_VERSION"],
    "torchvision": os.environ["TORCHVISION_VERSION"],
    "transformers": os.environ["TRANSFORMERS_VERSION"],
}, open("/dev/stdout", "w"), indent=2, sort_keys=True)
PY
    REQUIRES="${REQUIRES}" ENGINE=systemone ENGINE_VERSION="${ENGINE_VERSION}" \
        TORCH_VERSION="${TORCH_VERSION}" TRANSFORMERS_VERSION="${TRANSFORMERS_VERSION}" \
        bash /opt/gpuworks/shared/assert_requires.sh
EOF

LABEL org.opencontainers.image.title="gpuworks-runner" \
      org.opencontainers.image.vendor="gpuworks" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      io.gpuworks.image.id="${IMAGE_ID}" \
      io.gpuworks.engine="systemone" \
      io.gpuworks.engine.version="${ENGINE_VERSION}" \
      io.gpuworks.framework="cuda" \
      io.gpuworks.framework.version="${FRAMEWORK_VERSION}" \
      io.gpuworks.requires="${REQUIRES}"
